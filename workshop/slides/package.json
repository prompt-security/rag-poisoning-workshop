{
  "name": "hidden-parrot-workshop-slides",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "split": "node scripts/split-slides.mjs",
    "build": "slidev build",
    "build:pages": "slidev build --base /rag-poisoning-workshop/ --out dist",
    "export": "slidev export --format pdf",
    "export:pdf": "slidev export --format pdf",
    "export:pptx": "slidev export --format pptx --no-with-clicks",
    "videos": "bash scripts/make-videos.sh build/vid"
  },
  "dependencies": {
    "@slidev/cli": "^52.19.1",
    "@slidev/theme-default": "^0.25.0",
    "asciinema-player": "^3.17.0",
    "slidev-addon-asciinema": "^0.1.11"
  },
  "devDependencies": {
    "playwright-chromium": "^1.62.1"
  }
}
