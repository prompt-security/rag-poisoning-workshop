# slidev
workshop/slides/node_modules/
workshop/slides/dist/
workshop/slides/.slidev/
workshop/slides/build/
workshop/slides/*.pptx
workshop/slides/*.pdf
# Exported decks are build output: release.yml attaches PDF + PPTX to each tagged
# Release, so they are never committed (a checked-in copy just goes stale).
workshop/*.pdf
workshop/*.pptx
