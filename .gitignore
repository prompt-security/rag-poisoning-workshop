# OS / editor cruft
# .DS_Store records a folder's listing (including names of files since deleted),
# so it is worth keeping out of a public repo, not just out of the way.
.DS_Store
.DS_Store?
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

